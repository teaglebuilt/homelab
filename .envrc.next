export AWS_PROFILE="${HOMELAB_AWS_PROFILE:-production}"
HOMELAB_SHELL_SECRETS="${HOMELAB_SHELL_SECRETS:-N8N_API_KEY UNIFI_API_KEY}"

source_env_if_exists .envrc.local
dotenv_if_exists homelab.env
watch_file homelab.env homelab.sops.env

load_sops_keys() {
  local file=$1 decrypted line key
  shift
  [ -f "$file" ] || return 0
  if ! decrypted="$(sops --decrypt "$file" 2>/dev/null)"; then
    log_error "cannot decrypt $file with AWS_PROFILE=$AWS_PROFILE; shell secrets not loaded"
    return 0
  fi
  while IFS= read -r line; do
    key=${line%%=*}
    case " $* " in *" $key "*) export "$key=${line#*=}" ;; esac
  done <<< "$decrypted"
}

load_sops_keys homelab.sops.env $HOMELAB_SHELL_SECRETS

export KUBECONFIG="$(pwd)/kubernetes/generated/mlops/kubeconfig:$(pwd)/kubernetes/generated/application/kubeconfig"

export TALOSCONFIG="$(pwd)/kubernetes/generated/talosconfig"
rm -f "$TALOSCONFIG"
for _cluster in mlops application; do
  _tc="$(pwd)/kubernetes/generated/${_cluster}/talosconfig"
  [ -f "$_tc" ] || continue
  if [ -f "$TALOSCONFIG" ]; then
    talosctl --talosconfig "$TALOSCONFIG" config merge "$_tc" >/dev/null 2>&1
  else
    cp "$_tc" "$TALOSCONFIG"
  fi
done
unset _cluster _tc

export AI_GATEWAY_IP=$(kubectl get gateway ai-gateway -n ai -o jsonpath='{.status.addresses[0].value}' 2>/dev/null)
export MLOPS_INTERNAL_GATEWAY_IP=$(kubectl get gateway homelab-internal-gateway -n kube-system -o jsonpath='{.status.addresses[0].value}' 2>/dev/null)

export LLM_BACKEND="${LLM_BACKEND:-gateway}"
case "$LLM_BACKEND" in
  gateway)
    export ANTHROPIC_BASE_URL="http://${AI_GATEWAY_IP}/anthropic"
    ;;
  vllm)
    export ANTHROPIC_BASE_URL="http://${AI_GATEWAY_IP}/vllm"
    export ANTHROPIC_CUSTOM_MODEL_OPTION="${HOMELAB_VLLM_MODEL:-Qwen/Qwen2.5-3B-Instruct}"
    export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="${HOMELAB_VLLM_MODEL_NAME:-qwen2.5-3b-instruct}"
    ;;
esac

export GO111MODULE=on
export CLAUDE_CODE_ENABLE_TELEMETRY=1
