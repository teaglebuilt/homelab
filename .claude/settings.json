  "autoMode": {
    "environment": [
      "$defaults",
      "This repo operates a live homelab: two Talos Kubernetes clusters (contexts 'mlops' and 'application'), Proxmox VMs, UniFi networking, and Docker Compose stacks under platform/. There is no staging environment — every cluster command hits production.",
      "kubernetes/generated/ is Helmfile output and must not be hand-edited.",
      "Secrets are SOPS-encrypted with AWS KMS. Decrypting one prints plaintext into the transcript."
    ],
    "soft_deny": [
      "$defaults",
      "Any command that mutates Kubernetes cluster state, in any flag order or via any kubectl alias or absolute path: apply, delete, patch, replace, edit, scale, rollout, exec, cp, drain, cordon, taint, annotate, label.",
      "Any Helm, Helmfile, or ArgoCD command that installs, upgrades, syncs, rolls back, or uninstalls a release.",
      "terraform/tofu apply, destroy, import, or state rm/mv, and any ansible-playbook run.",
      "talosctl apply-config, bootstrap, reset, upgrade, upgrade-k8s, reboot, shutdown, or etcd subcommands — these can take a cluster node down or lose etcd quorum.",
      "task deploy-kubernetes and task platform:deploy, which run the full staged provisioning flow.",
      "docker compose up or down against any stack in platform/.",
      "git push, git reset --hard, git clean, and gh pr merge."
    ],
    "hard_deny": [
      "$defaults",
      "Running sops -d / --decrypt on any file, or otherwise printing decrypted secret material into the transcript or into an unencrypted file.",
      "Writing a plaintext secret, token, or private key into any tracked file — secrets only ever land in *.enc.yaml via sops -e.",
      "Editing kubernetes/generated/** by hand."
    ]
  }
}
