ARG BASE_IMAGE=ghcr.io/kagent-dev/kagent/claude-harness@sha256:e72d66d9f3b6eafbc59d18cef150fb5d31cb89ead83999a33c06264c21e86d4c
FROM ${BASE_IMAGE}
ARG CLAUDE_CODE_VERSION
ARG TARGETARCH

USER root
RUN test -n "${CLAUDE_CODE_VERSION}" || { echo "CLAUDE_CODE_VERSION is required" >&2; exit 1; } \
    && case "${TARGETARCH}" in \
        amd64) platform="linux-x64-musl" ;; \
        arm64) platform="linux-arm64-musl" ;; \
        *) echo "unsupported target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && base="https://downloads.claude.ai/claude-code-releases/${CLAUDE_CODE_VERSION}" \
    && apk add --no-cache --virtual .fetch jq \
    && checksum="$(wget -qO- "${base}/manifest.json" | jq -er --arg p "${platform}" '.platforms[$p].checksum')" \
    && wget -T 60 -t 3 -O /usr/local/bin/claude "${base}/${platform}/claude" \
    && echo "${checksum}  /usr/local/bin/claude" | sha256sum -c - \
    && chmod 0755 /usr/local/bin/claude \
    && apk del .fetch
USER 65532:65532

LABEL dev.claude.code.version="${CLAUDE_CODE_VERSION}"
