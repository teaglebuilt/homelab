---
cloudflare:
  account: {{ requiredEnv "CLOUDFLARE_ACCOUNT_TAG" }}
  tunnelName: homelab_external
  tunnelId: {{ requiredEnv "CLOUDFLARE_TUNNEL_ID" }}
  secret: {{ requiredEnv "CLOUDFLARE_TUNNEL_SECRET" }}
  # NOTE: this tunnel is remotely managed (source=cloudflare) — cloudflared IGNORES
  # the ingress rules below and pulls its config from Cloudflare's edge. Tunnel
  # routing is owned in terraform/cloudflare_tunnel.tf, NOT here (that is where the
  # n8n.teaglebuilt.tech -> mlops gateway rule lives). These rules are retained only
  # as documentation of the intended default backends.
  ingress:
    - hostname: {{ requiredEnv "CLOUDFLARE_DOMAIN" }}
      service: https://cilium-gateway-homelab-external-gateway.kube-system.svc.cluster.local
      originRequest:
        noTLSVerify: true
        originServerName: {{ requiredEnv "CLOUDFLARE_DOMAIN" }}
    - hostname: "*.{{ requiredEnv "CLOUDFLARE_DOMAIN" }}"
      service: https://cilium-gateway-homelab-external-gateway.kube-system.svc.cluster.local
      originRequest:
        noTLSVerify: true

image:
  tag: "2025.11.1"
  pullPolicy: Always
