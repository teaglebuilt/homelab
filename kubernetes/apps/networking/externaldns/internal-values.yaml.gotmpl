---
fullnameOverride: external-dns-unifi
logLevel: &logLevel debug
provider:
  name: webhook
  webhook:
    image:
      repository: ghcr.io/kashalls/external-dns-unifi-webhook
      tag: main
    env:
      - name: UNIFI_HOST
        value: {{ requiredEnv "UNIFI_NETWORK_GATEWAY" | quote }}
      - name: UNIFI_EXTERNAL_CONTROLLER
        value: "false"
      - name: UNIFI_SKIP_TLS_VERIFY
        value: "true"
      - name: UNIFI_API_KEY
        value: {{ requiredEnv "UNIFI_API_KEY" | quote }}
      - name: LOG_LEVEL
        value: *logLevel
    livenessProbe:
      httpGet:
        path: /healthz
        port: http-webhook
      initialDelaySeconds: 10
      timeoutSeconds: 5
    readinessProbe:
      httpGet:
        path: /readyz
        port: http-webhook
      initialDelaySeconds: 10
      timeoutSeconds: 5
extraArgs:
  - --ignore-ingress-tls-spec
policy: sync
sources: ["ingress", "service", "gateway-httproute", "gateway-tlsroute"]
# Owner ID MUST be unique per cluster. Every cluster's internal-dns writes to the
# same UniFi controller, so a shared owner id makes each instance believe it owns
# the other's records: under policy=sync they delete each other's A and TXT records
# every reconcile. Ownership TXT then never survives a loop, every record reads as
# unowned, and external-dns silently drops all UPDATEs (an IP change never applies).
txtOwnerId: k8s-{{ .Values | get "cluster" "mlops" }}
txtPrefix: k8s-{{ .Values | get "cluster" "mlops" }}.
domainFilters: ["internal", "teaglebuilt.tech"]
interval: 1m
triggerLoopOnEvent: true
{{- if eq (.Values | get "cluster" "mlops") "mlops" }}
# Pin to the capable node on mlops. Other clusters (e.g. application) schedule the
# DNS controller on any node — mlops-work-01 does not exist there.
nodeSelector:
  kubernetes.io/hostname: mlops-work-01
{{- end }}
