---
{{- $self := readFile "cluster.yaml" | fromYaml }}
{{- $peer := readFile "../mlops/cluster.yaml" | fromYaml }}
{{- $selfLB := required "clusters/application/cluster.yaml is missing clustermeshApiserverLB" $self.clustermeshApiserverLB }}
{{- $peerLB := required "clusters/mlops/cluster.yaml is missing clustermeshApiserverLB" $peer.clustermeshApiserverLB }}
clustermesh:
  useAPIServer: true
  apiserver:
    service:
      type: LoadBalancer
      annotations:
        io.cilium/lb-ipam-ips: {{ $selfLB | quote }}
    tls:
      authMode: cluster
      server:
        # The peer's KVStoreMesh (enabled by default in 1.18) dials THIS apiserver
        # by its raw LoadBalancer IP (clustermesh.config.clusters[].address below is
        # an IP, not a DNS name). Go's TLS client verifies the IP against the cert's
        # iPAddress SANs, so this cluster's apiserver LB IP MUST be a SAN here or the
        # cross-cluster handshake fails with "hostname mismatch" and KVStoreMesh can
        # never cache the remote cluster-config (mesh stays NOT READY on both sides).
        extraIpAddresses:
          - {{ $selfLB | quote }}
        extraDnsNames:
          - clustermesh-application.homelab
  config:
    enabled: true
    clusters:
      - name: mlops
        address: {{ $peerLB | quote }}
        port: 2379
