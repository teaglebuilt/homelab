machine:
  install:
    # Extensions are only applied at install/upgrade time. Without this, an
    # upgrade resolves the generic installer and silently drops the schematic's
    # extensions (on igpu nodes, the NVIDIA kernel modules).
    image: ${installer_image}
  network:
    hostname: ${hostname}
    interfaces:
      - interface: eth0
        addresses:
          - ${node_ip}
  kubelet:
    clusterDNS:
      - ${cluster_dns}
  nodeLabels:
    topology.kubernetes.io/region: ${cluster_name}
    topology.kubernetes.io/zone: ${node_name}
